PORT=3001
PUBLIC_URL=https://www.kuzeykaleinsaat.com

# Generate with: npm run hash-password -- 'your-long-password'
ADMIN_PASSWORD_HASH=replace-with-generated-salt-and-hash
SESSION_HOURS=8
COOKIE_SECURE=true

# Optional email notification for new quote requests
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM=Kuzeykale Website <notifications@example.com>
LEAD_NOTIFICATION_EMAIL=info@kuzeykaleinsaat.com
